TG_API_ID=123456
TG_API_HASH=your_api_hash
TG_BOT_TOKEN=your_bot_token

# DaData.ru — базовые данные о компании
DADATA_API_KEY=your_dadata_api_key
DADATA_TIMEOUT=10

# API-FNS.ru — данные из ЕГРЮЛ
FNS_API_KEY=your_fns_api_key
FNS_TIMEOUT=15

# ФССП — проверка исполнительных производств
FSSP_API_KEY=your_fssp_api_key
FSSP_TIMEOUT=15

# ЗаЧестныйБизнес — арбитражные дела, ФССП, индекс, налоговые риски
# https://zachestnyibiznesapi.ru/docs
ZCHB_API_KEY=
ZCHB_TIMEOUT=15
# Базовый URL API (необязательно, есть дефолт в коде)
ZCHB_BASE_URL=
# TTL кэша (секунды, по умолчанию 24 часа)
ZCHB_CACHE_TTL=86400

# СБИС — финансовые данные (опционально)
SBIS_LOGIN=your_sbis_login
SBIS_PASSWORD=your_sbis_password
SBIS_API_KEY=your_sbis_api_key
SBIS_CLIENT_ID=your_sbis_client_id
SBIS_BASE_URL=https://online.sbis.ru/service/?class=crm_ClaimsService&method=get_organization_info
SBIS_TIMEOUT=10
SBIS_MOCK=false
SBIS_RETRIES=2
SBIS_RETRY_DELAY=1.0
SBIS_CACHE_TTL=300
CACHE_DIR=.cache

SBIS_MOCK_PORT=8081

# GigaChat (Sber) — ИИ-анализ компаний
# Authorization Data из кабинета Sber Studio (base64)
GIGACHAT_CREDENTIALS=
GIGACHAT_TIMEOUT=30

LOG_LEVEL=INFO
LOG_FORMAT=json  # json or plain

SENTRY_DSN=
SENTRY_ENV=dev
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_MAX_BREADCRUMBS=100
SENTRY_ATTACH_STACKTRACE=false

# Storage
STORAGE_DIR=storage
S3_BUCKET=
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT_URL=

# Metadata
METADATA_DIR=metadata

# ───────────────────────────────────────────────────────────────────
# Платежи
# ───────────────────────────────────────────────────────────────────

# Активный платёжный провайдер: tochka | yookassa
# Webhook-роуты обоих провайдеров всегда активны (для миграции),
# но создание новых платежей идёт через выбранный.
PAYMENT_PROVIDER=tochka

# Точка Банк — интернет-эквайринг (подписки)
# JWT-токен из кабинета Точки («Интеграции и API» → Сгенерировать JWT)
TOCHKA_JWT=
# client_id — отображается рядом с JWT в кабинете, нужен для webhook'ов
TOCHKA_CLIENT_ID=
# Код клиента — узнаётся через GET /open-banking/v1.0/customers
# (поле customerType: "Business")
TOCHKA_CUSTOMER_CODE=
# ID торговой точки (15 цифр, обязателен если ≥2 точек интернет-эквайринга)
TOCHKA_MERCHANT_ID=
# Базовый URL API (production по умолчанию)
TOCHKA_BASE_URL=https://enter.tochka.com/uapi
# Код системы налогообложения для чека 54-ФЗ (опционально)
TOCHKA_TAX_SYSTEM_CODE=

# ЮKassa — интернет-эквайринг с автоплатежами через save_payment_method
# Реквизиты магазина: Настройки → API → shopId / Секретный ключ
# https://yookassa.ru/my/api-keys-settings
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# База API (по умолчанию production; для тестового магазина тот же URL,
# отличаются только shopId/secret_key)
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
# Опциональный HMAC-секрет (если в кабинете ЮKassa включена подпись
# Y-Signature). По умолчанию пусто — безопасность только через IP-whitelist.
YOOKASSA_WEBHOOK_SECRET=
# Налоговая система чека 54-ФЗ:
#   1 ОСН, 2 УСН доход, 3 УСН доход-расход,
#   4 ЕНВД, 5 ЕСХН, 6 Патент
YOOKASSA_TAX_SYSTEM_CODE=2
# Ставка НДС в чеке:
#   1 без НДС, 2 0%, 3 10%, 4 20%, 5 10/110, 6 20/120
YOOKASSA_VAT_CODE=1
# Сохранять карту для рекуррентных автоплатежей.
# Если ЮKassa отвечает 403 "This store can't make recurring payments" —
# в магазине не подключена услуга save_payment_method. Поставьте false
# и обратитесь в поддержку ЮKassa с просьбой её активировать.
# Без рекуррентов: подписки работают разово, пользователь продлевает сам.
YOOKASSA_SAVE_PAYMENT_METHOD=true

# URL возврата после оплаты (лучше — ссылка на бота: https://t.me/your_bot)
PAYMENT_REDIRECT_URL=https://t.me/
PAYMENT_FAIL_REDIRECT_URL=https://t.me/

# HTTP-сервер для приёма webhook'ов от Точки
# Точке нужен публичный HTTPS URL (через nginx + Let's Encrypt)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Публичный URL webhook'а — для авто-регистрации в Точке при старте
# Пример: https://fridaycompanybot.ru/tochka/webhook
WEBHOOK_PUBLIC_URL=

# Хранилище платежей
PAYMENTS_FILE=payments.json

# Файлы локального состояния (имеют дефолты — переопределяйте только если
# нужен путь отличный от /opt/bot/<file>.json).
USERS_FILE=users.json
MONITORING_FILE=monitoring.json
REPORT_TOKENS_FILE=report_tokens.json

# Публичный URL генератора веб-отчётов (для премиум-кнопки в боте).
# Пусто = веб-отчёты отключены, показываются только в Telegram.
REPORT_BASE_URL=

# Обязательная подписка на канал перед использованием бота.
# Формат: @username (для публичных каналов) или -100... (id для приватных).
# Бот ДОЛЖЕН быть админом канала, иначе get_chat_member вернёт ошибку.
# Пусто = проверка отключена.
REQUIRED_CHANNEL=@Monday_company

# Telegram user_id админов через запятую. Им доступна команда /admin
# для просмотра реалтайм-отчёта по сервису.
# Узнать свой ID: @userinfobot → /start.
ADMIN_USER_IDS=2009025508
